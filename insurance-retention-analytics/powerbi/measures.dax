// ============================================================
// Insurance Retention Analytics — DAX Measures
// ============================================================
// Cómo usar:
//   1. En Power BI, abre la tabla _Measures.
//   2. Click derecho → New measure.
//   3. Copia y pega CADA medida individual (desde el nombre hasta el = inclusive).
//   4. Pulsa Enter para guardar.
//   5. Repite con la siguiente.
//
// Las medidas están agrupadas por página del dashboard.
// ============================================================


// ============================================================
// GRUPO 1 — KPIs base (usados en Página 1)
// ============================================================

m_TotalCustomers = COUNTROWS ( customer )


m_TotalChurners =
CALCULATE (
    COUNTROWS ( customer ),
    customer[churn_flag] = 1
)


m_ChurnRate =
DIVIDE (
    [m_TotalChurners],
    [m_TotalCustomers],
    0
)


m_RetentionRate = 1 - [m_ChurnRate]


m_AvgPremium = AVERAGE ( customer[current_premium] )


m_TotalRevenue = SUM ( customer[current_premium] )


m_AvgTenureMonths = AVERAGE ( customer[customer_tenure_months] )


m_MultiPolicyPct =
DIVIDE (
    CALCULATE ( COUNTROWS ( customer ), customer[multi_policy_flag] = 1 ),
    [m_TotalCustomers]
)


m_ComplaintRatePct =
DIVIDE (
    CALCULATE ( COUNTROWS ( customer ), customer[complaint_flag] = 1 ),
    [m_TotalCustomers]
)



// ============================================================
// GRUPO 2 — Bucket counts (usados en Página 1 y 5)
// ============================================================

m_CountCritico =
CALCULATE (
    COUNTROWS ( vw_customer_360 ),
    vw_customer_360[risk_bucket] = "1_Critico"
)


m_CountAlto =
CALCULATE (
    COUNTROWS ( vw_customer_360 ),
    vw_customer_360[risk_bucket] = "2_Alto"
)


m_CountMedio =
CALCULATE (
    COUNTROWS ( vw_customer_360 ),
    vw_customer_360[risk_bucket] = "3_Medio"
)


m_CountBajo =
CALCULATE (
    COUNTROWS ( vw_customer_360 ),
    vw_customer_360[risk_bucket] = "4_Bajo"
)



// ============================================================
// GRUPO 3 — Métricas económicas (usados en Página 5)
// ============================================================

m_RevenueAtRisk =
CALCULATE (
    SUM ( vw_customer_360[current_premium] ),
    vw_customer_360[risk_bucket] IN { "1_Critico", "2_Alto" }
)


m_ExpectedRevenueLoss =
CALCULATE (
    SUM ( vw_customer_360[current_premium] ),
    vw_customer_360[risk_bucket] IN { "1_Critico", "2_Alto" },
    vw_customer_360[churn_flag] = 1
)


m_RevenueRecoverable = [m_ExpectedRevenueLoss] * 0.30


m_CampaignCost = ( [m_CountCritico] + [m_CountAlto] ) * 15


m_NetImpact = [m_RevenueRecoverable] - [m_CampaignCost]


m_CampaignROI =
DIVIDE (
    [m_NetImpact],
    [m_CampaignCost],
    0
)


m_CrossSellTargets = COUNTROWS ( vw_customer_360 ) -- ajustar con filtro real abajo
// Nota: para cross-sell target real, mejor crear una columna calculada o usar:
m_CrossSellTargetsReal =
CALCULATE (
    COUNTROWS ( vw_customer_360 ),
    vw_customer_360[num_policies] = 1,
    vw_customer_360[predicted_churn_probability] < 0.35,
    vw_customer_360[customer_tenure_months] >= 12
)


m_CrossSellUpside =
[m_CrossSellTargetsReal] * 0.15 * [m_AvgPremium] * 0.70



// ============================================================
// GRUPO 4 — Métricas de modelo (Página 4 — ML Insights)
// Estas son valores fijos del modelo entrenado en Python.
// La estrategia profesional es crear una tabla manual con estos KPIs
// y referenciarlos. Pero para simplicidad, las dejamos como constantes:
// ============================================================

m_ModelAccuracy   = 0.760
m_ModelPrecision  = 0.616
m_ModelRecall     = 0.546
m_ModelF1Score    = 0.579
m_ModelROCAUC     = 0.789
m_ModelPRAUC      = 0.661



// ============================================================
// GRUPO 5 — Métricas de calibración (Página 4)
// ============================================================

m_AvgPredictedProba =
AVERAGE ( vw_customer_360[predicted_churn_probability] )


m_PredictedChurnRate = [m_AvgPredictedProba]


m_ActualVsPredictedGap = ABS ( [m_ChurnRate] - [m_PredictedChurnRate] )



// ============================================================
// FORMATEO RECOMENDADO POR MEDIDA
// (Aplicar manualmente en el panel Modeling → Format)
// ============================================================
//
// m_TotalCustomers, m_TotalChurners → Whole number (#,##0)
// m_ChurnRate, m_RetentionRate, m_MultiPolicyPct, m_ComplaintRatePct → Percentage (0.00%)
// m_AvgPremium, m_TotalRevenue, m_RevenueAtRisk, etc. → Currency ($#,##0)
// m_AvgTenureMonths → Number (#,##0.0)
// m_ModelAccuracy, m_ModelPrecision, etc. → Percentage (0.00%)
// m_AvgPredictedProba → Percentage (0.00%)
// m_CampaignROI → Percentage (0.0%)
//
